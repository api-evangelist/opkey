          "name": "Check App Installed Via Bundle ID",
          "request": {
            "name": "Check App Installed Via Bundle ID",
            "description": {
              "content": "Checks whether an application identified by its bundle id is currently installed on a reserved iOS device, returning a true/false result. Use it as a precondition before launching or installing, to avoid redundant installs and to branch test logic on app presence. iOS only.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "check-app-installed"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "pCloudy cloud host prefix; the docs refer to this as <Cloud URL>. (This can only be one of device,demo,aus)",
