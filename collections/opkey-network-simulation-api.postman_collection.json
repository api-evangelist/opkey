          "name": "Start Network Simulation(V2)",
          "request": {
            "name": "Start Network Simulation(V2)",
            "description": {
              "content": "Starts network shaping/throttling on the device using the specified upload and download speeds to emulate real-world conditions such as 3G, 4G, or poor connectivity. Used to test app behaviour under constrained bandwidth; stop it with the stop-throttle call.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "networkshaping",
                "start-throttle"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "pCloudy cloud host prefix; the docs refer to this as <Cloud URL>. (This can only be one of device,demo,aus)",
