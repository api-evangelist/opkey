            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "Sets the device system timezone to the supplied value. Used to test time-zone-dependent behaviour such as schedules, timestamps, daylight-saving handling, and localized date/time formatting."
        },
        {
