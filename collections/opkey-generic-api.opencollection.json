{
  "opencollection": "1.0.0",
  "info": {
    "name": "pCloudy Device Cloud Generic API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
