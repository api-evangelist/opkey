      "item": [
        {
          "id": "4b17b484-501e-4fcb-89d0-6f68a25394d1",
          "name": "Authentication",
          "request": {
            "name": "Authentication",
            "description": {
              "content": "Authenticates the API user with Basic auth (username:API key) and returns an access token used to authorize all subsequent API calls. This is the first call in any automation flow; the returned token is sent in the header of the other endpoints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "access"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "your email id"
                },
                {
                  "disabled": false,
                  "key": "accessKey",
                  "value": "<string>",
                  "description": "your access key (you will get it from Account Settings->API)"
                }
              ],
              "variable": [
                {
                  "description": "pCloudy cloud host prefix; the docs refer to this as <Cloud URL>. (This can only be one of device,demo,aus)",
                  "type": "any",
                  "value": "{{cloud}}",
                  "key": "cloud"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "adde6b6a-8a5b-4ded-8991-984dae1ba93d",
              "name": "Successful response",
              "originalRequest": {
