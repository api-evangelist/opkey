{
  "opencollection": "1.0.0",
  "info": {
    "name": "pCloudy Device Cloud Resigning Apis API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resigning Apis",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Initiate the Resigning",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cloud}.pcloudy.com/api/resign/initiate",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "This api initiate the zip file for resigning."
        },
        {
          "info": {
            "name": "Resigning Progress",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cloud}.pcloudy.com/api/resign/progress",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "This api used for get the resinging status."
        },
        {
          "info": {
            "name": "Download Resigned File",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cloud}.pcloudy.com/api/resign/download",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "This api helps to download the resinged file into MYAPP/DATA section."
        }
      ]
    }
  ],
  "bundled": true
}