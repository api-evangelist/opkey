{
  "opencollection": "1.0.0",
  "info": {
    "name": "pCloudy Device Cloud Performance API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Performance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Start Transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cloud}.pcloudy.com/api/v2/start-transaction",
            "headers": [
              {
                "name": "token",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "Starts a named performance transaction on the device to measure a discrete user flow, optionally enabling HAR network capture for the transaction window. Used to mark the beginning of a segment for which performance metrics (and network traffic) should be collected; close it with the stop-transaction call."
        }
      ]
    }
  ],
  "bundled": true
}